{
  "name": "video-notes-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "BYOK 视频学习笔记 Chrome 插件：提取 Udemy 字幕 → LLM 生成中文笔记 → 写入 Obsidian",
